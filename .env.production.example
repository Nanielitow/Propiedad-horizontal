# =============================================================================
#  PH Gestión · Variables de PRODUCCIÓN
#  En el servidor:  cp .env.production.example .env.production  y complete.
#  deploy/generate-secrets.sh rellena automáticamente las contraseñas y el JWT.
#  NUNCA suba .env.production a Git (está en .gitignore).
# =============================================================================

# --- Dominio -------------------------------------------------------------------
# Dirección pública (Caddy pide el certificado HTTPS para este nombre)
SITE_ADDRESS=app.su-dominio.com
APP_URL=https://app.su-dominio.com
CORS_ORIGINS=https://app.su-dominio.com

# --- Imágenes (las publica GitHub Actions en GHCR) ----------------------------------
API_IMAGE=ghcr.io/nanielitow/propiedad-horizontal-api
WEB_IMAGE=ghcr.io/nanielitow/propiedad-horizontal-web
# "latest" o el SHA de un commit concreto (para volver a una versión anterior)
IMAGE_TAG=latest

ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Modo demo pública ------------------------------------------------------------
# true: los datos se restauran cada noche desde una instantánea, límites más
# estrictos por red y subidas pequeñas. false para uso real con edificios.
DEMO_MODE=true
MAX_UPLOAD_MB=10

# --- PostgreSQL (dentro del servidor, sin puerto público) -------------------------
POSTGRES_USER=ph_owner
POSTGRES_PASSWORD=__GENERAR__
POSTGRES_DB=ph_saas
APP_DB_USER=app_user
APP_DB_PASSWORD=__GENERAR__
DATABASE_URL=postgresql+asyncpg://app_user:${APP_DB_PASSWORD}@postgres:5432/ph_saas
SYNC_DATABASE_URL=postgresql+psycopg://app_user:${APP_DB_PASSWORD}@postgres:5432/ph_saas
MIGRATIONS_DATABASE_URL=postgresql+psycopg://ph_owner:${POSTGRES_PASSWORD}@postgres:5432/ph_saas

# --- Redis (dentro del servidor, con contraseña) ----------------------------------
REDIS_PASSWORD=__GENERAR__
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2

# --- Cloudflare R2 (archivos) --------------------------------------------------------
# Endpoint: https://<ID_DE_CUENTA>.r2.cloudflarestorage.com (panel de R2)
S3_ENDPOINT_URL=https://SU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT_URL=https://SU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ph-gestion-documentos
S3_REGION=auto
S3_PRESIGNED_TTL_SECONDS=300
# Bucket aparte para las copias de seguridad de la base de datos
BACKUP_BUCKET=ph-gestion-backups

# --- Autenticación -------------------------------------------------------------------
JWT_SECRET=__GENERAR__
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- IA ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
CHAT_MODEL=gemini-3.5-flash-lite
EXTRACTION_MODEL=gemini-3.5-flash
CHAT_THINKING_LEVEL=minimal
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# --- Correo (Resend por SMTP) -----------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=resend
# La API key de Resend es la contraseña SMTP
SMTP_PASSWORD=
SMTP_FROM=PH Gestión <recordatorios@su-dominio.com>
