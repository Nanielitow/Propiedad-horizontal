{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/apps/api/**", "/deploy/railway/worker.json"]
  },
  "deploy": {
    "startCommand": "celery -A app.workers.celery_app worker -Q ingestion,default --concurrency 2 --max-tasks-per-child 50 --loglevel INFO",
    "restartPolicyType": "ALWAYS"
  }
}
