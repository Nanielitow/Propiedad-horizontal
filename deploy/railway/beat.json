{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/apps/api/**", "/deploy/railway/beat.json"]
  },
  "deploy": {
    "startCommand": "celery -A app.workers.celery_app beat --loglevel INFO --schedule /tmp/celerybeat-schedule",
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS"
  }
}
