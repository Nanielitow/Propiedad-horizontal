# Copiar a .env.local cuando el frontend corre fuera de Docker (npm run web:dev)
# URL de la API vista desde el servidor de Next.js (el navegador usa /api/proxy)
API_INTERNAL_URL=http://localhost:8000
# Botones de cuentas demo en el login (portafolio). false en producción.
NEXT_PUBLIC_DEMO_MODE=true
