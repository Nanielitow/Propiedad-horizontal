# =============================================================================
#  Copiar a .env  (cp .env.example .env). Nunca commitear .env.
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------
# Owner del esquema: solo para migraciones (Alembic). Es superusuario en local.
POSTGRES_USER=ph_owner
POSTGRES_PASSWORD=ph_owner_dev
POSTGRES_DB=ph_saas
# Rol de la aplicación: sin BYPASSRLS, sujeto a Row Level Security.
APP_DB_USER=app_user
APP_DB_PASSWORD=app_user_dev

DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev@postgres:5432/ph_saas
SYNC_DATABASE_URL=postgresql+psycopg://app_user:app_user_dev@postgres:5432/ph_saas
MIGRATIONS_DATABASE_URL=postgresql+psycopg://ph_owner:ph_owner_dev@postgres:5432/ph_saas

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Almacenamiento S3 (SeaweedFS local / Cloudflare R2 en prod) -----------
S3_ENDPOINT_URL=http://seaweedfs:8333
# Host con el que se FIRMAN las URLs: debe ser alcanzable desde el navegador.
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
# Deben coincidir con infra/seaweedfs/s3.json
S3_ACCESS_KEY_ID=phdevaccesskey
S3_SECRET_ACCESS_KEY=phdevsecretkey
S3_BUCKET=ph-documents
S3_REGION=us-east-1
S3_PRESIGNED_TTL_SECONDS=300
MAX_UPLOAD_MB=50

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-with-openssl-rand-hex-32
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000

# --- IA ----------------------------------------------------------------------
# openai | gemini
LLM_PROVIDER=openai
# openai | gemini | fake  (fake = vectores locales sin API key, SOLO desarrollo)
# Con gemini usar EMBEDDING_MODEL=gemini-embedding-001 (admite 1536 dimensiones)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EXTRACTION_MODEL=gpt-4.1-mini
# Solo Gemini 3: razonamiento interno (minimal/low/medium/high; vacío = por defecto)
# Con Gemini: CHAT_MODEL=gemini-3.5-flash-lite (≈0,6 s al primer token), EXTRACTION_MODEL=gemini-3.5-flash
CHAT_THINKING_LEVEL=minimal
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Correo (recordatorios de vencimientos) -----------------------------------
# Local: Mailpit (bandeja en http://localhost:8025). Producción: proveedor SMTP real.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PH Gestión <no-responder@phgestion.local>
APP_URL=http://localhost:3000

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Muestra en el login los botones de cuentas demo (portafolio). false en producción.
NEXT_PUBLIC_DEMO_MODE=true

# --- Importar desde Google Drive (opcional) ----------------------------------
# Credenciales del proyecto de Google Cloud (ver docs/DEPLOY.md, "Google Drive").
# Son públicas por diseño (ID de cliente OAuth y API key restringida a los dominios
# de la app). Si se dejan vacías, el botón "Desde Google Drive" no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_PROJECT_NUMBER=
